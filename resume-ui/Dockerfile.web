FROM node:22-bookworm-slim AS deps
WORKDIR /app/resume-ui
COPY resume-ui/package*.json ./
RUN npm ci

FROM deps AS builder
WORKDIR /app
COPY . .
WORKDIR /app/resume-ui
RUN npm run build

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps /app/resume-ui/node_modules /app/resume-ui/node_modules
COPY --from=builder /app /app
WORKDIR /app/resume-ui
EXPOSE 4173
CMD ["npm", "run", "start"]
