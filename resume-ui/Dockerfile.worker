FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    make \
    perl \
    ghostscript \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-fonts-extra \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app/resume-ui
COPY resume-ui/package*.json ./
RUN npm ci

WORKDIR /app
COPY . .
WORKDIR /app/resume-ui
CMD ["npm", "run", "start:worker"]
